{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/register-form", "destination": "/index.html" },
    { "source": "/esct_presentation", "destination": "/index.html" },
    { "source": "/esct_presentation.html", "destination": "/index.html" },
    { "source": "/verum-landing", "destination": "/index.html" },
    { "source": "/verum-landing.html", "destination": "/index.html" },
    { "source": "/bode-coin-landing", "destination": "/index.html" },
    { "source": "/bode-coin-landing.html", "destination": "/index.html" },
    { "source": "/terms-privacy", "destination": "/terms-privacy.html" },
    { "source": "/terms-of-service", "destination": "/terms-of-service.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*).(png|jpe?g|svg|ico|webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
